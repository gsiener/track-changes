{
  "name": "track-changes",
  "version": "0.1.0",
  "description": "CLI tool for Claude to review Google Docs with suggested edits",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "track-changes": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "agent-browser": "^0.5.0",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0",
    "googleapis": "^130.0.0",
    "playwright-core": "^1.57.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^2.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
